{
	"expo": {
		"name": "TaDaa-AI",
		"slug": "tadaa-ai",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "tadaaai",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.nelsonnxx4s.tadaaai"
		},
		"android": {
			"package": "com.nelsonnxx4s.tadaaai",
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/Tadaa-logo.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"image": "./assets/images/Tadaa-logo-dark.png",
						"backgroundColor": "#18211C"
					}
				}
			],
			"expo-audio",
			"expo-font",
			"expo-image",
			[
				"expo-image-picker",
				{
					"cameraPermission": "Allow Ta-Daa AI to open your camera for Food Snap.",
					"photosPermission": "Allow Ta-Daa AI to choose food photos from your library."
				}
			],
			"expo-web-browser",
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "e901b5ec-23e8-414d-9994-83d2cad3015c"
			}
		},
		"owner": "nelsonnxx4s-team"
	}
}
